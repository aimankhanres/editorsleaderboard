# --- Database (Neon Postgres, add it from the Vercel Marketplace) ---
DATABASE_URL=

# --- Triple Whale ---
TRIPLEWHALE_API_KEY=
TRIPLEWHALE_SHOP_ID=yourstore.myshopify.com
# Channel value as Triple Whale stores it for Meta
TRIPLEWHALE_CHANNEL=facebook-ads

# --- ClickUp ---
CLICKUP_TOKEN=pk_xxx
CLICKUP_TEAM_ID=1234567
# Name of the custom field on each task that holds the editor
CLICKUP_EDITOR_FIELD=Editor
# OO-xxxx lives in the "Brief ID" short-text custom field (confirmed Nov 2026; custom task IDs are RS-xxxx).
# Tasks are looked up by this field's value. Leave empty only if OO-xxxx ever becomes the custom task ID.
CLICKUP_BRIEF_FIELD_ID=f129c811-0d3b-481d-9971-eb0b10bcf746
# Optional: secret from the ClickUp webhook you create (see README)
CLICKUP_WEBHOOK_SECRET=

# --- Behaviour ---
# split = an ad with two editors gives each half. joint = credit goes to the pair as one entry.
SPLIT_MODE=split
REPORT_TIMEZONE=America/New_York
MAX_CLICKUP_LOOKUPS_PER_RUN=80
EDITOR_REFRESH_HOURS=6

# Seconds /api/sync may spend before stopping ClickUp lookups (function limit is 300)
SYNC_BUDGET_SECONDS=240

# --- Security ---
# Vercel sends this automatically as a Bearer token to cron routes
CRON_SECRET=
# Optional shared password for the dashboard (HTTP Basic auth, any username). Empty = open.
APP_PASSWORD=
